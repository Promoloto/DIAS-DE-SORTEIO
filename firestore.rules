rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health-check / test connection
    match /test/{testId} {
      allow read: if true;
    }

    // Configurações globais compartilhadas (dados da lotérica)
    match /settings/{settingId} {
      // Leitura e escrita públicas para sincronização entre todos os dispositivos, visitantes e abas anônimas
      allow read, write: if settingId in ['game_logos', 'app_config'];
    }

    // Coleção individual de logotipos de cada jogo (resolve o limite de 1MB por documento)
    match /game_logos/{gameId} {
      allow read, write: if true;
    }

    // Cadastro de clientes (Lotéricas) por código da Caixa (para busca via QR Code e gestão multi-cliente)
    match /lotteries/{lotteryId} {
      allow read, write: if true;
    }
  }
}
